# PostgreSQL Database Credentials
SUPABASE_DB_HOST="your-supabase-host"
SUPABASE_DB_PORT="5432"
SUPABASE_DB_NAME="postgres"
SUPABASE_DB_USER="your-supabase-user"
SUPABASE_DB_PASSWORD="your-supabase-password"
SUPABASE_DB_SSLMODE="require"
DBT_SUPABASE_SCHEMA="valorant"
DBT_THREADS="4"

# rib.gg extract job (optional)
# RIB_RUN_DATE="2026-07-26"
# RIB_ENRICH_PLAYERS_VIA_API="false"
# RIB_MAX_TEAM_DETAILS="200"

# VLR.gg extract job (optional)
# VLR_RUN_DATE="2026-07-26"
# VLR_EVENT_STATUS="completed"
# VLR_EVENT_PAGE_START="1"
# VLR_EVENT_PAGE_END="59"
# VLR_REQUEST_DELAY_SEC="0.1"
# VLR_HTML_MAX_WORKERS="10"
# VLR_API_MAX_WORKERS="10"
# VLR_MAX_MATCHES="20"

# AWS IP rotator (API Gateway — not free-tier). Used by the vlrggapi container.
VLR_USE_IP_ROTATOR="1"
AWS_ACCESS_KEY_ID="YOUR_AWS_ACCESS_KEY_ID"
AWS_SECRET_ACCESS_KEY="YOUR_AWS_SECRET_ACCESS_KEY"
AWS_DEFAULT_REGION="us-east-1"
# Start with one enabled region (IAM: AmazonAPIGatewayAdministrator)
VLR_IP_ROTATOR_REGIONS="us-east-1"